{%- comment -%}
  Fastrr account icon v2.
  - Swaps the theme's account icon for the Fastrr icon (classic links and Shopify's <shopify-account>).
  - Signed-out shoppers who click any account link or icon get the Shiprocket login
    (shipRocketMarketingLogin) instead of Shopify's sign-in. Signed-in shoppers go to their account as before.
  Install: in layout/theme.liquid, add this line just before </head>:
    {% render 'fastrr-account-icon' %}
  Delete any older account-icon script from the theme first (one that inserts its own
  account link, or removes the theme's account icon), or the store shows two icons.
  Remove: delete the render line. The theme's own icon and sign-in come back.
{%- endcomment -%}
<style>
/* Fastrr account icon. Hides the theme's account icon only while the swap is pending
   (at most 1.5 s), so shoppers never see two icons or a jump. */
html.fastrr-icon-pending a[href$="/account"] svg,
html.fastrr-icon-pending a[href*="/account?"] svg,
html.fastrr-icon-pending a[href*="/account/login"] svg,
html.fastrr-icon-pending a[href*="/customer_authentication/login"] svg,
html.fastrr-icon-pending a.header__icon--account svg,
html.fastrr-icon-pending shopify-account { visibility: hidden; }

.fastrr-account-icon { display: block; flex: none; overflow: visible; }
</style>
<script>
  window.__fastrrCustomerLoggedIn = {% if customer %}true{% else %}false{% endif %};
  document.documentElement.classList.add('fastrr-icon-pending');
  setTimeout(function () { document.documentElement.classList.remove('fastrr-icon-pending'); }, 1500);
</script>
<script>
/* Fastrr account icon v2: replaces the theme's account icon with the Fastrr icon, and
   sends signed-out shoppers who click any account link or icon to the Shiprocket login
   (shipRocketMarketingLogin) instead of Shopify's sign-in. Safe to load more than once.
   Needs window.__fastrrCustomerLoggedIn = true / false, set from Liquid before this runs. */
(function () {
  if (window.__fastrrAccountIcon) return;
  window.__fastrrAccountIcon = true;

  var SVG = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" class="fastrr-account-icon"><path class="fastrr-icon-person" fill-rule="evenodd" style="fill: var(--fastrr-icon-person, currentColor)" d="M15.71 4.40L15.60 4.17L15.49 3.96L15.37 3.76L15.24 3.56L15.10 3.37L14.95 3.19L14.80 3.01L14.63 2.84L14.46 2.68L14.28 2.53L14.09 2.39L13.89 2.26L13.69 2.14L13.48 2.03L13.27 1.92L13.05 1.83L12.83 1.75L12.61 1.68L12.38 1.62L12.15 1.58L11.92 1.54L11.68 1.52L11.45 1.50L11.21 1.50L10.98 1.51L10.74 1.53L10.51 1.57L10.28 1.61L10.05 1.67L9.82 1.73L9.60 1.81L9.38 1.90L9.17 2.00L8.96 2.11L8.76 2.23L8.56 2.36L8.37 2.50L8.19 2.65L8.01 2.80L7.84 2.97L7.68 3.14L7.53 3.32L7.39 3.51L7.26 3.71L7.14 3.91L7.03 4.12L6.92 4.33L6.83 4.55L6.75 4.77L6.68 4.99L6.62 5.22L6.58 5.45L6.54 5.68L6.52 5.92L6.50 6.15L6.50 6.39L6.51 6.62L6.53 6.86L6.57 7.09L6.61 7.32L6.67 7.55L6.73 7.78L6.81 8.00L6.90 8.22L7.04 8.51L7.20 8.79L7.39 9.09L7.59 9.35L7.80 9.59L8.05 9.84L8.30 10.05L8.58 10.25L8.55 10.03L8.55 9.91L8.57 9.79L8.60 9.67L8.63 9.55L8.69 9.43L8.75 9.33L8.86 9.18L8.99 9.05L9.09 8.97L9.67 8.57L9.50 8.44L9.34 8.30L9.20 8.15L9.07 8.00L8.95 7.83L8.85 7.65L8.75 7.47L8.68 7.28L8.61 7.08L8.56 6.88L8.53 6.68L8.51 6.47L8.50 6.27L8.51 6.06L8.54 5.86L8.58 5.64L8.67 5.34L8.80 5.04L8.96 4.76L9.16 4.50L9.37 4.27L9.62 4.06L9.89 3.88L10.18 3.73L10.45 3.63L10.75 3.55L11.04 3.51L11.35 3.50L11.66 3.52L11.95 3.58L12.24 3.66L12.51 3.78L12.77 3.92L13.02 4.09L13.24 4.28L13.45 4.51L13.63 4.74L13.79 5.01L13.91 5.29L14.00 5.58ZM4.61 19.29L4.62 19.13L4.67 18.83L4.73 18.54L4.81 18.26L4.91 17.99L5.03 17.73L5.16 17.48L5.32 17.24L5.49 17.00L5.67 16.78L5.87 16.57L6.08 16.38L6.31 16.19L6.56 16.02L6.81 15.87L7.08 15.73L7.50 15.54L7.95 15.40L8.41 15.29L8.90 15.22L9.23 15.20L9.41 15.20L12.83 15.20L12.47 13.34L12.26 13.20L9.19 13.20L8.70 13.23L8.48 13.26L8.07 13.32L7.82 13.37L7.39 13.47L6.98 13.60L6.57 13.76L6.18 13.94L5.81 14.14L5.44 14.36L5.10 14.61L4.79 14.85L4.64 14.99L4.31 15.31L4.05 15.60L3.92 15.76L3.67 16.10L3.43 16.49L3.24 16.83L3.15 17.02L2.98 17.45L2.84 17.86L2.74 18.25L2.69 18.50L2.64 18.91L2.62 19.13L2.60 19.60L2.60 21.05L2.61 21.15L2.64 21.29L2.68 21.38L2.74 21.51L2.80 21.60L2.89 21.71L2.97 21.77L3.09 21.86L3.26 21.94L3.45 21.99L3.65 22.00L3.84 21.97L4.03 21.90L4.20 21.80L4.34 21.67L4.46 21.51L4.52 21.38L4.56 21.29L4.59 21.15L4.60 21.05L4.60 19.61ZM17.49 17.57L17.63 17.86L17.69 17.99L17.79 18.26L17.87 18.54L17.90 18.69L17.96 18.98L17.99 19.29L18.00 19.44L18.00 21.05L18.02 21.20L18.08 21.38L18.17 21.56L18.29 21.71L18.44 21.83L18.62 21.92L18.80 21.98L19.00 22.00L19.20 21.98L19.38 21.92L19.47 21.88L19.60 21.80L19.71 21.71L19.80 21.60L19.88 21.47L19.92 21.38L19.97 21.24L19.99 21.15L20.00 21.00L20.00 19.39L19.97 18.94L19.91 18.50L19.81 18.07L19.68 17.62L19.53 17.22L19.45 17.02L19.28 16.67L19.06 16.30L18.81 15.93L18.55 15.60L18.41 15.44L18.20 15.22Z"/><path class="fastrr-icon-plane-top" style="fill: var(--fastrr-icon-plane-top, #9F87FF)" d="M20.92 2.49L20.95 2.43L20.95 2.37L20.93 2.32L20.91 2.29L20.86 2.26L20.83 2.25L20.77 2.25L20.71 2.28L9.71 9.88L9.67 9.92L9.65 9.97L9.65 10.03L9.67 10.08L9.72 10.12L13.52 12.72L13.57 12.75L13.60 12.75L13.65 12.74L13.68 12.73L13.72 12.69Z"/><path class="fastrr-icon-plane-bottom" style="fill: var(--fastrr-icon-plane-bottom, #5837CB)" d="M20.94 2.44L20.95 2.41L20.95 2.38L20.94 2.35L20.93 2.33L20.91 2.30L20.89 2.28L20.87 2.27L20.84 2.25L20.81 2.25L20.78 2.25L20.75 2.26L20.72 2.27L20.70 2.29L20.68 2.31L13.48 12.51L13.46 12.54L13.45 12.57L13.45 12.60L13.45 12.63L15.05 20.83L15.07 20.88L15.09 20.90L15.11 20.92L15.16 20.95L15.22 20.95L15.27 20.93L15.32 20.89L15.34 20.84Z"/></svg>';
  var LINKS = [
    'a[href$="/account"]', 'a[href*="/account?"]', 'a[href*="/account/login"]',
    'a[href*="/customer_authentication/login"]', 'a.header__icon--account', '[data-fastrr-account]'
  ].join(',');
  var root = document.documentElement;

  function reveal() { root.classList.remove('fastrr-icon-pending'); }

  function makeIcon() {
    var t = document.createElement('template');
    t.innerHTML = SVG;
    var s = t.content.firstChild;
    s.setAttribute('aria-hidden', 'true');
    s.setAttribute('focusable', 'false');
    s.setAttribute('data-fastrr-icon', '');
    return s;
  }

  /* Light or dark header: pick the plane colours with the better contrast. */
  function lum(c) {
    var v = (c.match(/[\d.]+/g) || [255, 255, 255]).slice(0, 3).map(function (x) {
      x = x / 255; return x <= 0.03928 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4);
    });
    return 0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2];
  }
  function contrast(a, b) { return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05); }
  function background(el) {
    while (el && el !== root) {
      var c = getComputedStyle(el).backgroundColor;
      if (c && c !== 'transparent' && !/rgba\(.*,\s*0\)$/.test(c)) return c;
      el = el.parentElement;
    }
    return 'rgb(255, 255, 255)';
  }
  function fit(icon, host) {
    var L = lum(background(host));
    var dark = contrast(L, lum('rgb(156,134,242)')) > contrast(L, lum('rgb(88,55,203)'));
    icon.style.setProperty('--fastrr-icon-plane-top', dark ? '#D2C6FF' : '#9F87FF');
    icon.style.setProperty('--fastrr-icon-plane-bottom', dark ? '#9C86F2' : '#5837CB');
  }

  /* Classic themes: swap the icon inside the theme's own account link. */
  function swapLink(a) {
    if (a.hasAttribute('data-fastrr-swapped') || a.closest('shopify-account')) return;
    var old = a.querySelector('svg:not([data-fastrr-icon]), img');
    if (!old) return;                       // text-only link (footer, menu): leave it
    var icon = makeIcon();
    var cls = old.getAttribute('class');
    if (cls) icon.setAttribute('class', cls + ' fastrr-account-icon'); else icon.setAttribute('class', 'fastrr-account-icon');
    var w = old.getAttribute('width'), h = old.getAttribute('height');
    var r = old.getBoundingClientRect();
    var size = Math.round(Math.max(r.width, r.height)) || parseFloat(w) || parseFloat(h) || 24;
    icon.setAttribute('width', w || size);
    icon.setAttribute('height', h || size);
    old.style.setProperty('display', 'none', 'important'); // hidden, not removed: theme scripts keep working
    old.parentNode.insertBefore(icon, old.nextSibling);
    a.setAttribute('data-fastrr-swapped', '');
    fit(icon, a);
  }

  /* New customer accounts themes (<shopify-account>): the signed-out icon sits in the
     "signed-out-avatar" slot. Themes such as Horizon put their own icon there, inside a
     wrapper that the theme shows or hides (icon or text label). We swap the picture inside
     that wrapper, so the theme's own show/hide logic keeps working. With nothing in the
     slot, ours replaces Shopify's default avatar. */
  function sizeFor(old) {
    var r = old.getBoundingClientRect();
    var m = Math.max(r.width || parseFloat(old.getAttribute('width')) || 0,
                     r.height || parseFloat(old.getAttribute('height')) || 0);
    // our person fills 20.5 of the 24-unit grid: match the theme person's height
    return m ? Math.min(32, Math.max(18, Math.round(m * 24 / 20.5))) : 24;
  }

  function replaceIn(c, old, slotted) {
    if (old.hasAttribute('data-fastrr-replaced')) return;
    var icon = makeIcon(), size = sizeFor(old);
    if (slotted) {                                   // the slotted element is the icon itself
      icon.setAttribute('slot', 'signed-out-avatar');
      icon.setAttribute('class', ((old.getAttribute('class') || '') + ' fastrr-account-icon').trim());
    } else {
      icon.setAttribute('class', 'fastrr-account-icon');
    }
    icon.setAttribute('width', size);
    icon.setAttribute('height', size);
    old.style.setProperty('display', 'none', 'important');
    old.setAttribute('data-fastrr-replaced', '');
    old.parentNode.insertBefore(icon, old.nextSibling);
    fit(icon, c);
  }

  function swapComponent(c) {
    var kids = Array.prototype.filter.call(c.children, function (k) {
      return k.getAttribute('slot') === 'signed-out-avatar' &&
        !k.hasAttribute('data-fastrr-icon-slot') && !k.hasAttribute('data-fastrr-icon');
    });
    kids.forEach(function (k) {
      if (/^(svg|img)$/i.test(k.tagName)) return replaceIn(c, k, true);
      var old = k.querySelector('svg:not([data-fastrr-icon]), img');
      if (old) replaceIn(c, old, false);             // a text label ("Account") is left alone
    });
    if (kids.length || c.querySelector(':scope > [data-fastrr-icon-slot]')) return;
    var slot = document.createElement('span');
    slot.setAttribute('slot', 'signed-out-avatar');
    slot.setAttribute('data-fastrr-icon-slot', '');
    slot.setAttribute('aria-hidden', 'true');
    slot.style.display = 'inline-flex';
    var icon = makeIcon();
    icon.setAttribute('class', 'fastrr-account-icon');
    icon.setAttribute('width', '24');
    icon.setAttribute('height', '24');
    slot.appendChild(icon);
    c.appendChild(slot);
    fit(icon, c);
  }

  function run() {
    try {
      Array.prototype.forEach.call(document.querySelectorAll('shopify-account'), swapComponent);
      Array.prototype.forEach.call(document.querySelectorAll(LINKS), swapLink);
    } finally {
      reveal();                             // never leave the theme icon hidden
    }
  }

  /* ---- Login: signed-out clicks on any account link or icon open the Shiprocket login ----
     Signed in, or sign-in state unknown: the theme behaves as it always did.
     Login script not loaded yet: wait up to 2 s for it, then open the store's own login.
     Login script throws: open the store's own login. Shoppers never hit a dead click. */
  var TARGETS = LINKS + ',shopify-account';
  var WAIT_MS = 2000;
  var busy = false;

  function signedOut() { return window.__fastrrCustomerLoggedIn === false; }

  function loginFn() {
    if (typeof shipRocketMarketingLogin === 'function') return shipRocketMarketingLogin; // eslint-disable-line no-undef
    return null;
  }

  function targetOf(e) {
    var path = e.composedPath ? e.composedPath() : [e.target];
    for (var i = 0; i < path.length; i++) {
      var el = path[i];
      if (el && el.nodeType === 1 && el.matches && el.matches(TARGETS)) return el;
    }
    return null;
  }

  function storeLogin(el) {
    window.location.href = (el && el.tagName === 'A' && el.href) ? el.href : '/account';
  }

  function startLogin(el) {
    if (busy) return;
    busy = true;
    var t0 = Date.now();
    (function attempt() {
      var fn = loginFn();
      if (fn) {
        busy = false;
        try { fn(); } catch (err) { console.warn('[Fastrr] login failed, opening the store login', err); storeLogin(el); }
        return;
      }
      if (Date.now() - t0 >= WAIT_MS) { busy = false; storeLogin(el); return; }
      setTimeout(attempt, 100);
    })();
  }

  function take(e) { e.preventDefault(); e.stopImmediatePropagation(); }

  window.addEventListener('click', function (e) {
    if (e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return; // new tab etc.
    var el = targetOf(e);
    if (!el) return;
    if (!signedOut()) {
      if (el.tagName !== 'A' && el.tagName !== 'SHOPIFY-ACCOUNT') { take(e); window.location.href = '/account'; }
      return;
    }
    take(e);
    startLogin(el);
  }, true);

  /* Shopify's account component opens its sheet from its own handlers: keep them from
     seeing the press while signed out. The click above then opens our login. */
  function guardComponent(e) {
    if (!signedOut()) return;
    var el = targetOf(e);
    if (!el || el.tagName !== 'SHOPIFY-ACCOUNT') return;
    if (e.type === 'keydown') {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      take(e);
      startLogin(el);
      return;
    }
    e.stopImmediatePropagation();
  }
  ['pointerdown', 'pointerup', 'mousedown', 'mouseup', 'touchstart', 'touchend', 'keydown'].forEach(function (type) {
    window.addEventListener(type, guardComponent, { capture: true, passive: type.indexOf('touch') === 0 });
  });

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
  else run();

  /* Headers that re-render (sticky clones, section rendering, mobile drawers). */
  var t;
  new MutationObserver(function () { clearTimeout(t); t = setTimeout(run, 60); })
    .observe(root, { childList: true, subtree: true });
})();
</script>
